{
  "name": "killthebird",
  "version": "0.1.0",
  "description": "3D moorland bird-shooting arcade game (three.js) as a drop-in React / Next.js component. Parallax depth layers, edge scrolling, sound, bonus targets and score callbacks.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "game",
    "threejs",
    "three",
    "react",
    "nextjs",
    "shooter",
    "arcade",
    "3d"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "killthebird": "bin/killthebird.mjs"
  },
  "files": [
    "dist",
    "assets",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:models": "node scripts/build-models.mjs",
    "build:audio": "node scripts/build-audio.mjs",
    "prepublishOnly": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "meshoptimizer": "1.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Ricky Kleinhempel",
  "homepage": "https://rickykleinhempel.github.io/killthebird/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RickyKleinhempel/killthebird.git",
    "directory": "packages/killthebird"
  },
  "bugs": {
    "url": "https://github.com/RickyKleinhempel/killthebird/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
